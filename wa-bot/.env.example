# Konfigurasi AniTrack WhatsApp Bot (Oracle Cloud VPS)
PORT=3001
TZ=Asia/Jakarta

# Token rahasia untuk mengakses endpoint Custom Webhook (/send & /run-deadline-check)
# Ganti dengan teks acak yang kuat, lalu tempel token yang sama di Portal Admin -> Drive & Backup -> Notifikasi WA
WA_API_SECRET=ganti_dengan_token_rahasia_anitrack_2026

# URL Portal AniTrack yang dicantumkan di pesan WA siswa
APP_URL=https://anitrack.republikanimasi.my.id

# Koneksi Supabase AniTrack
SUPABASE_URL=https://izgcmhsobexicceqklqm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_T9eODcUv7nRBYgN-F24aRg_w-QOzKVu

# Jadwal otomatis setiap hari jam 07:00 WIB (format cron: menit jam * * *)
CRON_SCHEDULE=0 7 * * *

# Jeda antar pengiriman pesan (milidetik) agar aman dari pemblokiran WhatsApp
SEND_DELAY_MS=3000

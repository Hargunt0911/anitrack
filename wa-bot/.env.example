# Konfigurasi AniTrack WhatsApp Bot (Oracle Cloud VPS)
PORT=3001
TZ=Asia/Jakarta

# Token rahasia untuk mengakses endpoint Custom Webhook (/send & /run-deadline-check)
# Ganti dengan teks acak yang kuat, lalu tempel token yang sama di Portal Admin -> Drive & Backup -> Notifikasi WA
WA_API_SECRET=ganti_dengan_token_rahasia_anitrack_2026

# URL Portal AniTrack yang dicantumkan di pesan WA siswa
APP_URL=https://anitrack.republikanimasi.my.id

# Koneksi Supabase AniTrack
SUPABASE_URL=https://izgcmhsobexicceqklqm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_T9eODcUv7nRBYgN-F24aRg_w-QOzKVu

# Jadwal otomatis setiap hari jam 07:00 WIB (format cron: menit jam * * *)
CRON_SCHEDULE=0 7 * * *

# Mode Ekstra Aman (Anti-Ban Ketat):
# Simulasi mengetik 2-4 detik, jeda acak 25-45 detik antar siswa, istirahat 3 menit setiap 10 pesan
TYPING_MIN_MS=2000
TYPING_MAX_MS=4000
SEND_DELAY_MIN_MS=25000
SEND_DELAY_MAX_MS=45000
COOLDOWN_EVERY=10
COOLDOWN_MS=180000

# Balas otomatis kata kunci (hanya di chat pribadi, tidak membalas di grup):
# Kata kunci: menu, siap, cek, cek <nama/username>, progres, tugas, deadline
AUTO_REPLY_ENABLED=true
AUTO_REPLY_COOLDOWN_MS=6000

# Keamanan Panel Web Lokal (http://127.0.0.1:3001) untuk PC Kantor:
# - Ganti PANEL_PASSWORD dengan password rahasia Anda sendiri.
# - Setelah selesai scan QR 1x, Anda bisa ubah PANEL_ENABLED=false agar halaman web tidak bisa dibuka siapa pun (bot tetap jalan diam-diam di background).
PANEL_ENABLED=true
PANEL_USER=hargunt
PANEL_PASSWORD=anitrack2026
